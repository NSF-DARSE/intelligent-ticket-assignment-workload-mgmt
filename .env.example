DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Intelligent Ticket Assignment & Workload Management

# Autotask sandbox configuration
# Example base URL:
# https://wwxx.autotask.net/ATServicesRest/V1.0/
AUTOTASK_API_BASE_URL=
AUTOTASK_API_USERNAME=
AUTOTASK_API_SECRET=
AUTOTASK_API_INTEGRATION_CODE=

# Optional: use zone info discovery instead of setting AUTOTASK_API_BASE_URL directly
AUTOTASK_ZONE_INFO_URL=https://webservices.autotask.net/ATServicesRest/V1.0/zoneInformation

# Optional fetch defaults
AUTOTASK_PAGE_SIZE=500
